# Wix: Settings > API Keys. Needs read access to Pricing Plans and Contacts.
WIX_API_KEY=
WIX_SITE_ID=

# Sentry: User Settings > Personal Tokens, scopes org:read, project:read, event:read.
SENTRY_AUTH_TOKEN=
# The slug in your Sentry URL, e.g. https://<org>.sentry.io
SENTRY_ORG=
# Optional, default https://sentry.io (EU region: https://de.sentry.io)
SENTRY_BASE_URL=

# IQ Option login for collect-candles (an account without two-factor login).
IQ_OPTION_USER=
IQ_OPTION_PASSWORD=

# Turso database for collect-candles: app.turso.tech > database > URL, and Create Token (read & write, no expiry).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: folder for reports (default: data). Absolute or relative to the repo.
DATA_DIR=
